{
  "openapi": "3.0.1",
  "info": {
    "title": "Open Banking Gateway API",
    "version": "v0"
  },
  "servers": [
    {
      "url": "/",
      "description": "MuleSoft API Gateway"
    }
  ],
  "paths": {
    "/v1/accounts/transactions": {
      "post": {
        "tags": [
          "transactions"
        ],
        "summary": "Get transaction history",
        "operationId": "getTransactionHistory",
        "parameters": [
          {
            "$ref": "#/components/parameters/Authorization"
          },
          {
            "$ref": "#/components/parameters/TppId"
          },
          {
            "$ref": "#/components/parameters/ProviderId"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/RequestDateTime"
          },
          {
            "$ref": "#/components/parameters/PsuIpAddress"
          },
          {
            "$ref": "#/components/parameters/PsuUserAgent"
          },
          {
            "$ref": "#/components/parameters/PsuDeviceOs"
          },
          {
            "$ref": "#/components/parameters/ClientId"
          },
          {
            "$ref": "#/components/parameters/JwsSignature"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionHistoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction history returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionHistory"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "429": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Authorization": {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^Bearer\\s+\\S+$"
        }
      },
      "TppId": {
        "name": "TPP-ID",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        }
      },
      "ProviderId": {
        "name": "Provider-ID",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        }
      },
      "RequestId": {
        "name": "Request-ID",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "RequestDateTime": {
        "name": "Request-DateTime",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "PsuIpAddress": {
        "name": "PSU-IP-Address",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "PsuUserAgent": {
        "name": "PSU-User-Agent",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      },
      "PsuDeviceOs": {
        "name": "PSU-Device-OS",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 100
        }
      },
      "ClientId": {
        "name": "Client-ID",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 50
        }
      },
      "JwsSignature": {
        "name": "JWS-Signature",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "Request rejected",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "TransactionHistoryRequest": {
        "required": [
          "accountId",
          "fromDate",
          "toDate"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 34
          },
          "fromDate": {
            "type": "string",
            "format": "date-time"
          },
          "toDate": {
            "type": "string",
            "format": "date-time"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        }
      },
      "Money": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "Party": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "bankCode": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          }
        }
      },
      "References": {
        "type": "object",
        "properties": {
          "instructionIdentification": {
            "type": "string"
          }
        }
      },
      "RelatedParties": {
        "type": "object",
        "properties": {
          "debtor": {
            "$ref": "#/components/schemas/Party"
          },
          "creditor": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "balances": {
            "$ref": "#/components/schemas/Money"
          },
          "creditDebitIndicator": {
            "type": "string",
            "enum": [
              "CRDT",
              "DBIT"
            ]
          },
          "reversalIndicator": {
            "type": "boolean"
          },
          "valueDate": {
            "type": "string",
            "format": "date-time"
          },
          "references": {
            "$ref": "#/components/schemas/References"
          },
          "relatedParties": {
            "$ref": "#/components/schemas/RelatedParties"
          },
          "additionalTransactionInformation": {
            "type": "string"
          },
          "additionalInfo": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TransactionHistory": {
        "type": "object",
        "properties": {
          "pageCount": {
            "type": "integer",
            "format": "int32"
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          },
          "nextPage": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int64"
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "code",
          "description"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
