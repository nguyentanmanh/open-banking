    "/internal/simulator/balance-changes": {
      "post": {
        "tags": [
          "balance-change-simulator-endpoint"
        ],
        "operationId": "publish",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "pattern": "Bearer\\s+\\S+",
              "type": "string"
            }
          },
          {
            "name": "TPP-ID",
            "in": "header",
            "required": true,
            "schema": {
              "maxLength": 15,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "Provider-ID",
            "in": "header",
