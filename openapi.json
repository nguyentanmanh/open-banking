  "components": {
    "schemas": {
      "TransactionHistoryRequest": {
        "required": [
          "accountId",
          "fromDate",
          "toDate"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "maxLength": 34,
            "minLength": 0,
            "type": "string"
          },
          "fromDate": {
            "type": "string",
            "format": "date-time"
          },
          "toDate": {
            "type": "string",
            "format": "date-time"
          },
          "page": {
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Money": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "Party": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "bankCode": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          }
        }
      },
      "References": {
        "type": "object",
        "properties": {
          "instructionIdentification": {
            "type": "string"
          }
        }
      },
      "RelatedParties": {
        "type": "object",
        "properties": {
          "debtor": {
            "$ref": "#/components/schemas/Party"
          },
          "creditor": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "balances": {
            "$ref": "#/components/schemas/Money"
          },
          "creditDebitIndicator": {
            "type": "string",
            "enum": [
              "CRDT",
              "DBIT"
            ]
          },
          "reversalIndicator": {
            "type": "boolean"
          },
          "valueDate": {
            "type": "string",
            "format": "date-time"
          },
          "references": {
            "$ref": "#/components/schemas/References"
          },
          "relatedParties": {
            "$ref": "#/components/schemas/RelatedParties"
          },
          "additionalTransactionInformation": {
            "type": "string"
          },
          "additionalInfo": {
            "type": "object"
          }
        }
      },
      "TransactionHistory": {
        "type": "object",
        "properties": {
          "pageCount": {
            "type": "integer",
            "format": "int32"
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          },
          "nextPage": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int64"
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          }
        }
      },
      "BalanceChangeRequest": {
        "required": [
          "accountId",
          "amount",
          "balanceAfter",
          "currency",
          "direction",
          "occurredAt",
          "transactionId"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "accountId": {
            "maxLength": 34,
            "minLength": 0,
            "type": "string"
          },
          "transactionId": {
            "maxLength": 70,
            "minLength": 0,
            "type": "string"
          },
          "amount": {
            "minimum": 0.0,
            "exclusiveMinimum": true,
            "type": "number"
          },
          "currency": {
            "minLength": 1,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "CREDIT",
              "DEBIT"
            ]
          },
          "balanceAfter": {
            "type": "number"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AcceptedBalanceEvent": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
